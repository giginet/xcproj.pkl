amends "pkl:Project"

package {
  name = "xcproj"
  // PklProject evaluation supports env:, but not the CLI's prop: reader.
  version = read?("env:XCPROJ_PKL_PACKAGE_VERSION") ?? "0.1.0"
  baseUri = "package://github.com/giginet/xcproj.pkl/releases/download/pkl%2F\(version)/\(name)"
  packageZipUrl = "https://github.com/giginet/xcproj.pkl/releases/download/pkl%2F\(version)/package.zip"
  description = "Typed Pkl schemas for generating Xcode JSON projects and workspaces."
  sourceCode = "https://github.com/giginet/xcproj.pkl"
  sourceCodeUrlScheme = "\(sourceCode)/blob/pkl%2F\(version)/Pkl/xcproj%{path}#L%{line}-L%{endLine}"
  apiTests { "tests/ApiTests.pkl" }
  exclude { "tests/**" }
}
