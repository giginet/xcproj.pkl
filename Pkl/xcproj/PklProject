amends "pkl:Project"

package {
  name = "xcproj"
  // PklProject evaluation supports env:, but not the CLI's prop: reader.
  version = read?("env:XCPROJ_PKL_PACKAGE_VERSION") ?? read("Internal/Version.txt").text.trim()
  baseUri = "package://github.com/giginet/xcproj.pkl/releases/download/\(version)/\(name)"
  packageZipUrl = "https://github.com/giginet/xcproj.pkl/releases/download/\(version)/package.zip"
  description = "Typed Pkl schemas for generating Xcode JSON projects and workspaces."
  sourceCode = "https://github.com/giginet/xcproj.pkl"
  sourceCodeUrlScheme = "\(sourceCode)/blob/\(version)/Pkl/xcproj%{path}#L%{line}-L%{endLine}"
  apiTests { "tests/ApiTests.pkl" }
  exclude { "tests/**"; "doc-package-info.pkl"; "Internal/Version.txt" }
}
