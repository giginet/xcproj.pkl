open module xcproj.Workspace
import "Project.pkl"
import "pkl:reflect"
import "Internal/Snapshot.pkl" as Snapshot
import "Internal/Validation.pkl" as Validation

/// A read-only workspace member. Relative paths are anchored at workspaceDir.
open class ExistingProject {
  path: String(!isEmpty && (endsWith(".xcodeproj") || endsWith(".xcodeproj/")))
}
typealias WorkspaceProject = *Project | ExistingProject

/// Reference an existing .xcodeproj without converting or modifying its contents.
/// Relative paths are resolved against workspaceDir, including with --output-dir.
/// In an amended workspace, use `projects { ["key"] = module.importXcodeproj("App.xcodeproj") }`.
function importXcodeproj(value: String): ExistingProject = new { path = value }

typealias Scheme = Project.Scheme
typealias BuildAction = Project.BuildAction
typealias BuildTarget = Project.BuildTarget
typealias RunAction = Project.RunAction
typealias TestAction = Project.TestAction
typealias TestTarget = Project.TestTarget
typealias ProfileAction = Project.ProfileAction
typealias AnalyzeAction = Project.AnalyzeAction
typealias ArchiveAction = Project.ArchiveAction
typealias ExecutionAction = Project.ExecutionAction

kind: "workspace" = "workspace"
schemaVersion: Int(this == 2) = 2
name: String(!isEmpty)
workspaceDir: String = "."
projects: Mapping<String, WorkspaceProject>
schemes: Mapping<String, Scheme>

output {
  renderer = new JsonRenderer {}
  value = if (module.schemaVersion == 2 && module.kind == "workspace" && Validation.authorWorkspace(name, projects))
    Snapshot.workspace(module.name, module.workspaceDir, reflect.moduleOf(module).uri, module.projects, module.schemes)
  else throw("Invalid workspace")
}
