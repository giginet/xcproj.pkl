/// Public module class. Extend to define a project family; amend to instantiate it.
///
/// Typed authoring counterparts of apple/xcode-project-format 0.1.0.
/// Low-level paths and references use Xcode's own syntax; they are not source globs.
open module xcproj.Project

import "Internal/Snapshot.pkl" as Snapshot
import "Internal/Validation.pkl" as Validation

kind: "project" = "project"
schemaVersion: Int(this == 2) = 2
name: String(!isEmpty)
/// Prefix of each target's default `PRODUCT_BUNDLE_IDENTIFIER`, which is
/// `<bundleIdPrefix>.<target name>`. Also seeds the generated object IDs, so
/// changing it changes every generated ID in the project.
bundleIdPrefix: String(!isEmpty) = name
projectDir: String = "."
configs: Mapping<String, "debug" | "release"> = new {
  ["Debug"] = "debug"
  ["Release"] = "release"
}
defaultConfiguration: String = "Debug"
settings: Settings = new {}
configFiles: Mapping<String, String>
targets: Mapping<String, Target>
/// Low-level Xcode references use Xcode path anchors; sources use projectDir-relative paths.
files: Listing<Reference>
packages: Mapping<String, SwiftPackage>
configurationDetails: Mapping<String, Configuration>
localizations: Localizations = new {}
id: ObjectId?
rootGroupDebugId: ObjectId?
configurationListDebugId: ObjectId?
organization: String?
classPrefix: String?
productsGroup: GroupTreeReference? =
  if (targets.toMap().values.toList().any((t) -> t.kind == "native" && t.product == null)) "Products" else null
requiredCapabilities: Listing<String>
buildIndependentTargetsInParallel: Boolean = true
lastUpgrade: MarketingVersion?
lastSwiftUpdate: MarketingVersion?
lastSwiftMigration: MarketingVersion?
importedProducts: Listing<ImportedProduct>
schemes: Mapping<String, Scheme>

typealias SettingValue = String | Listing<String>
open class ConfigurationSettings {
  base: Mapping<String, SettingValue>
}
open class Settings {
  base: Mapping<String, SettingValue>
  configs: Mapping<String, ConfigurationSettings>
}
open class Target {
  name: String(!isEmpty)
  kind: TargetKind = "native"
  type: ProductType?
  fullProductType: String(!isEmpty)?
  platform: Platform = "macOS"
  deploymentTarget: String(matches(Regex(#"\d+(\.\d+){0,2}"#)))?
  id: ObjectId?
  productId: ObjectId?
  /// Full product filename (including extension), used by file references and schemes.
  /// Set matching product build settings when overriding.
  productName: String(!isEmpty)?
  productFileType: String(!isEmpty)?
  product: GroupTreeReference?
  settings: Settings = new {}
  configFiles: Mapping<String, String>
  infoPlist: String(!isEmpty)?
  sources: Listing<Source>
  dependencies: Listing<Dependency>
  targetDependencies: Listing<TargetDependency>
  packageProductMembers: Listing<PackageProductMember>
  /// Null keeps the generated phases. A Listing replaces them in exactly the specified order.
  buildPhases: Listing<BuildPhase>?
  preBuildScripts: Listing<ScriptBuildPhase>
  postBuildScripts: Listing<ScriptBuildPhase>
  buildRules: Listing<BuildRule>
  configurationDetails: Mapping<String, Configuration>
  testHostTarget: String(!isEmpty)?
  legacyProvisioningStyle: LegacyProvisioningStyle?
  legacyTeamId: String?
  lastSwiftUpdate: MarketingVersion?
  lastSwiftMigration: MarketingVersion?
  configurationListDebugId: ObjectId?
  buildToolPath: String(!isEmpty)?
  buildToolArguments: String = ""
  buildToolWorkingDirectory: String?
  passBuildSettingsInEnvironment: Boolean = true
}
class Source {
  path: String(!isEmpty)
  kind: "folder" | "file" = "folder"
  excludes: Listing<String>
}
class Dependency {
  target: String(!isEmpty)?
  package: String(!isEmpty)?
  product: String(!isEmpty)?
  productType: PackageProductType = "other"
  platforms: Listing<String>
  link: Boolean = true
  embed: Boolean = false
}

// Shared Xcode scheme configuration. Target references use target keys in projects
// and project-key/target-key in workspaces.

open class ExecutionAction {
  title: String = "Run Script"
  script: String
  environmentTarget: String?
}

open class BuildTarget {
  target: String(!isEmpty)
  forTesting: Boolean = true
  forRunning: Boolean = true
  forProfiling: Boolean = true
  forArchiving: Boolean = true
  forAnalyzing: Boolean = true
}

open class BuildAction {
  targets: Listing<BuildTarget>
  parallelizeBuild: Boolean = true
  buildImplicitDependencies: Boolean = true
  preActions: Listing<ExecutionAction>
  postActions: Listing<ExecutionAction>
}

open class ConfiguredAction {
  configuration: String(!isEmpty) = "Debug"
  preActions: Listing<ExecutionAction>
  postActions: Listing<ExecutionAction>
}

open class RunAction extends ConfiguredAction {
  target: String(!isEmpty)
  arguments: Listing<String>
  environment: Mapping<String, String>
}

open class TestTarget {
  target: String(!isEmpty)
  skipped: Boolean = false
  parallelizable: Boolean = false
}

open class TestAction extends ConfiguredAction {
  targets: Listing<TestTarget>
  arguments: Listing<String>
  environment: Mapping<String, String>
  inheritLaunchArguments: Boolean = true
  codeCoverage: Boolean = false
}

open class ProfileAction extends RunAction {
  configuration = "Release"
}

open class AnalyzeAction extends ConfiguredAction {}

open class ArchiveAction extends ConfiguredAction {
  configuration = "Release"
  revealArchiveInOrganizer: Boolean = true
}

open class Scheme {
  build: BuildAction = new {}
  run: RunAction?
  test: TestAction?
  profile: ProfileAction?
  analyze: AnalyzeAction?
  archive: ArchiveAction?
}

typealias TargetKind = "native" | "aggregate" | "external-build-system"
typealias Platform = "iOS" | "macOS" | "tvOS" | "watchOS" | "visionOS" | "driverKit"
/// Apple product identifiers with the com.apple.product-type. prefix omitted.
/// Use Target.fullProductType for identifiers outside this convenience enumeration.
typealias ProductType = "application" | "application.on-demand-install-capable"
  | "application.watchapp" | "application.watchapp2" | "application.watchapp2-container"
  | "application.messages" | "app-extension" | "extensionkit-extension"
  | "watchkit-extension" | "watchkit2-extension" | "app-extension.messages"
  | "app-extension.messages-sticker-pack" | "framework" | "framework.static"
  | "xcframework" | "library.static" | "library.dynamic" | "bundle"
  | "bundle.unit-test" | "bundle.ui-testing" | "bundle.ocunit-test" | "tool"
  | "xpc-service" | "driver-extension" | "system-extension" | "kernel-extension"
  | "instruments-package" | "metal-library"
typealias StandardBuildPhaseKind = "frameworks" | "headers" | "java-archive" | "resources" | "rez" | "compile-sources"
typealias BuildPhaseKind = StandardBuildPhaseKind | "apple-script" | "copy" | "script"
typealias BuildPhaseScope = "always" | "install"
typealias BundleBasePath = "root" | "build-products-directory" | "shared-frameworks-directory"
  | "shared-support-directory" | "java-directory" | "frameworks-directory"
  | "resources-directory" | "package-info-file" | "apple-scripts-directory"
  | "plugins-directory" | "private-headers-directory" | "headers-directory"
  | "contents-directory" | "executables-directory" | "info-plist-file"
  | "main-executable-file" | "shallow-main-executable-file"
typealias HeaderRole = "public" | "private"
typealias HeaderPreservation = "keep" | "remove-on-copy"
typealias MachInterfaceGeneration = "client" | "server" | "both"
typealias CodeGeneration = "default" | "skip"
typealias CodeGenerationVisibility = "public" | "private" | "project"
typealias LineEnding = "line-feed" | "carriage-return" | "carriage-return-line-feed" | "preserve"
typealias LegacyProvisioningStyle = "automatic" | "manual"
typealias SwiftPackageProductType = "other" | "build-tool-plugin"
typealias PackageProductType = SwiftPackageProductType
typealias PackageVersionKind = "revision" | "branch" | "version" | "version-range"
  | "up-to-next-minor-version" | "up-to-next-major-version"
typealias ExceptionSetSense = "inclusions" | "exclusions"
typealias MarketingVersion = String(matches(Regex(#"\d+\.\d+(\.\d+)?"#)))
/// IDs and file/product/platform identifiers are open strings in Apple's schema.
typealias ObjectID = String
typealias ObjectId = ObjectID
typealias PlatformFilter = String
typealias TextEncoding = "ascii" | "nextstep" | "japanese-euc" | "utf8" | "iso-latin-1"
  | "symbol" | "non-lossy-ascii" | "shift-jis" | "iso-latin-2" | "unicode"
  | "windows-code-page-1251" | "windows-code-page-1252" | "windows-code-page-1253"
  | "windows-code-page-1254" | "windows-code-page-1250" | "iso-2022-jp" | "macos-roman"
  | "utf16" | "utf16-big-endian" | "utf16-little-endian" | "utf32"
  | "utf32-big-endian" | "utf32-little-endian" | Int(this >= 0)

/// An explicit child name, including names such as ".." or names containing "/".
open class NamePathComponent { name: String }
typealias NamePath = String | Listing<String | NamePathComponent>
/// Name paths or id:<object-id>, as understood by Xcode.
typealias GroupTreeReference = NamePath
open class AnchoredFileReference {
  anchor: GroupTreeReference
  relativePath: NamePath
}
typealias AnchoredReference = GroupTreeReference | AnchoredFileReference

abstract class BuildPhase {
  kind: BuildPhaseKind
  id: ObjectID?
  name: String?
}
open class StandardBuildPhase extends BuildPhase {
  kind: StandardBuildPhaseKind = "compile-sources"
}
open class ScriptBuildPhase extends BuildPhase {
  kind: "script" = "script"
  shell: String = "/bin/sh"
  script: String
  logEnvironmentVariables: Boolean = false
  inputPaths: Listing<String>
  inputFileListPaths: Listing<String>
  outputPaths: Listing<String>
  outputFileListPaths: Listing<String>
  dependencyFile: String?
  runOnEveryBuild: Boolean = false
  scope: BuildPhaseScope = "always"
}
open class CopyFilesBuildPhase extends BuildPhase {
  kind: "copy" = "copy"
  bundleBasePath: BundleBasePath?
  relativePath: String = ""
  scope: BuildPhaseScope = "always"
}
open class AppleScriptBuildPhase extends BuildPhase {
  kind: "apple-script" = "apple-script"
  isSharedContext: Boolean = false
  contextName: String = ""
}
open class BuildRule {
  id: ObjectID?
  name: String?
  processor: String = "com.apple.compilers.proxy.script"
  fileType: String?
  filePatterns: String?
  script: String?
  inputFiles: Listing<String>
  inputFileLists: Listing<String>
  outputFiles: Listing<String>
  outputFileLists: Listing<String>
  outputFilesCompilerFlags: Listing<String>
  dependencyFile: String?
  runOncePerArchitecture: Boolean = true
}

open class BuildFileAttributes {
  headerRole: HeaderRole?
  machInterfaceGeneration: MachInterfaceGeneration?
  isWeak: Boolean = false
  codeSignOnCopy: Boolean = false
  codeGeneration: CodeGeneration = "default"
  headerPreservation: HeaderPreservation = "keep"
  decompress: Boolean = false
  codeGenerationVisibility: CodeGenerationVisibility?
}
open class BuildFileProperties extends BuildFileAttributes {
  platforms: Listing<String>
  arguments: String?
  assetTags: Listing<String>
}
open class ProjectBuildFile extends BuildFileProperties {
  id: ObjectID?
  /// `Target/kind[/phase-name]`, `id:<object-id>`, or explicit name components.
  buildPhase: GroupTreeReference
}
open class TargetBuildFile extends BuildFileProperties {
  id: ObjectID?
  /// `Kind[/phase-name]` or `id:<object-id>`, relative to the containing target.
  buildPhase: GroupTreeReference = "frameworks"
}

abstract class FolderExceptionSet {
  sense: ExceptionSetSense = "exclusions"
  members: Listing<String>
  platforms: Mapping<String, Listing<String>>
  attributes: Mapping<String, BuildFileAttributes>
  assetTags: Mapping<String, Listing<String>>
}
open class TargetExceptionSet extends FolderExceptionSet {
  target: String
  publicHeaders: Listing<String>
  privateHeaders: Listing<String>
  compilerFlags: Mapping<String, String>
}
open class BuildPhaseExceptionSet extends FolderExceptionSet {
  sense = "inclusions"
  buildPhase: GroupTreeReference
}

abstract class Reference {
  /// Xcode FilePath syntax: group-relative, absolute, <PROJECT>/, <SDK>/,
  /// <PRODUCTS>/, <DEVELOPER>/, or a source-root variable. Passed through unchanged.
  path: String = ""
  id: ObjectID?
  index: Boolean?
}
open class FileReference extends Reference {
  type: String?
  signature: String?
  encoding: TextEncoding?
  lineEnding: LineEnding?
  targetMembership: Listing<GroupTreeReference | ProjectBuildFile>
}
open class Folder extends Reference {
  targetMembership: Listing<String>
  membershipExceptions: Listing<FolderExceptionSet>
  fileTypes: Mapping<String, String>
  opaqueFolders: Listing<String>
}
open class Group extends Reference {
  name: String?
  children: Listing<Reference>
}
open class VariantGroup extends Reference {
  name: String?
  targetMembership: Listing<GroupTreeReference | ProjectBuildFile>
  children: Listing<FileReference>
}
open class VersionGroup extends Reference {
  name: String?
  currentVersion: GroupTreeReference?
  type: String?
  targetMembership: Listing<GroupTreeReference | ProjectBuildFile>
  children: Listing<FileReference>
}

open class PackageVersion {
  kind: PackageVersionKind = "up-to-next-major-version"
  value: String(!isEmpty)
  /// Exclusive upper bound; required only for version-range.
  maximum: String(!isEmpty)?
}
abstract class SwiftPackage { traits: Listing<String> }
open class LocalSwiftPackage extends SwiftPackage { path: String(!isEmpty) }
open class RemoteSwiftPackage extends SwiftPackage {
  repository: String(!isEmpty)
  version: PackageVersion?
}
abstract class TargetDependency { platforms: Listing<String> }
open class LocalTargetDependency extends TargetDependency { target: String }
open class RemoteTargetDependency extends TargetDependency {
  project: GroupTreeReference
  target: String
  targetId: ObjectID
}
open class PackageDependency extends TargetDependency {
  id: ObjectID?
  package: String?
  productName: String
  productType: SwiftPackageProductType = "other"
}
open class PackageProductMember {
  id: ObjectID?
  package: String?
  productName: String
  productType: SwiftPackageProductType = "other"
  buildPhase: TargetBuildFile = new {}
}
open class ImportedProduct {
  project: GroupTreeReference
  target: String
  productId: ObjectID
  path: String
  type: String?
  targetMembership: Listing<GroupTreeReference | ProjectBuildFile>
}
open class Configuration {
  name: String = ""
  id: ObjectID?
  file: AnchoredReference?
}
open class Localizations {
  development: String = "en"
  supported: Listing<String> = new { "Base" }
}

output {
  renderer = new JsonRenderer {}
  value = if (Validation.authorProject(module)) Snapshot.single(module) else throw("Invalid project")
}
