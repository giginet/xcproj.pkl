/// Public module class. Extend to define a project family; amend to instantiate it.
open module xcproj.Project
extends "Internal/ProjectModel.pkl"

import "Internal/Snapshot.pkl" as Snapshot
import "Internal/Validation.pkl" as Validation

output {
  renderer = new JsonRenderer {}
  value = if (Validation.authorProject(module)) Snapshot.single(module) else throw("Invalid project")
}
