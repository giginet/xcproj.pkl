/// Base module kept independent of projection and rendering to avoid import cycles.
open module xcproj.Internal.ProjectModel
extends "SchemaTypes.pkl"
import "SchemeModel.pkl" as SchemeModel

open class Scheme extends SchemeModel.Scheme {}
open class BuildAction extends SchemeModel.BuildAction {}
open class BuildTarget extends SchemeModel.BuildTarget {}
open class RunAction extends SchemeModel.RunAction {}
open class TestAction extends SchemeModel.TestAction {}
open class TestTarget extends SchemeModel.TestTarget {}
open class ProfileAction extends SchemeModel.ProfileAction {}
open class AnalyzeAction extends SchemeModel.AnalyzeAction {}
open class ArchiveAction extends SchemeModel.ArchiveAction {}
open class ExecutionAction extends SchemeModel.ExecutionAction {}

kind: "project" = "project"
schemaVersion: Int(this == 2) = 2
name: String(!isEmpty)
idNamespace: String(!isEmpty) = name
projectDir: String = "."
configs: Mapping<String, "debug" | "release"> = new {
  ["Debug"] = "debug"
  ["Release"] = "release"
}
defaultConfiguration: String = "Debug"
settings: Settings = new {}
configFiles: Mapping<String, String>
targets: Mapping<String, Target>
/// Low-level Xcode references use Xcode path anchors; sources use projectDir-relative paths.
files: Listing<Reference>
packages: Mapping<String, SwiftPackage>
configurationDetails: Mapping<String, Configuration>
localizations: Localizations = new {}
id: ObjectId?
rootGroupDebugId: ObjectId?
configurationListDebugId: ObjectId?
organization: String?
classPrefix: String?
productsGroup: GroupTreeReference? =
  if (targets.toMap().values.toList().any((t) -> t.kind == "native" && t.product == null)) "Products" else null
requiredCapabilities: Listing<String>
buildIndependentTargetsInParallel: Boolean = true
lastUpgrade: MarketingVersion?
lastSwiftUpdate: MarketingVersion?
lastSwiftMigration: MarketingVersion?
importedProducts: Listing<ImportedProduct>
schemes: Mapping<String, SchemeModel.Scheme>

typealias SettingValue = String | Listing<String>
open class ConfigurationSettings {
  base: Mapping<String, SettingValue>
}
open class Settings {
  base: Mapping<String, SettingValue>
  configs: Mapping<String, ConfigurationSettings>
}
open class Target {
  name: String(!isEmpty)
  kind: TargetKind = "native"
  type: ProductType?
  fullProductType: String(!isEmpty)?
  platform: Platform = "macOS"
  deploymentTarget: String(matches(Regex(#"\d+(\.\d+){0,2}"#)))?
  id: ObjectId?
  productId: ObjectId?
  /// Full product filename (including extension), used by file references and schemes.
  /// Set matching product build settings when overriding.
  productName: String(!isEmpty)?
  productFileType: String(!isEmpty)?
  product: GroupTreeReference?
  settings: Settings = new {}
  configFiles: Mapping<String, String>
  infoPlist: String(!isEmpty)?
  sources: Listing<Source>
  dependencies: Listing<Dependency>
  targetDependencies: Listing<TargetDependency>
  packageProductMembers: Listing<PackageProductMember>
  /// Null keeps the generated phases. A Listing replaces them in exactly the specified order.
  buildPhases: Listing<BuildPhase>?
  preBuildScripts: Listing<ScriptBuildPhase>
  postBuildScripts: Listing<ScriptBuildPhase>
  buildRules: Listing<BuildRule>
  configurationDetails: Mapping<String, Configuration>
  testHostTarget: String(!isEmpty)?
  legacyProvisioningStyle: LegacyProvisioningStyle?
  legacyTeamId: String?
  lastSwiftUpdate: MarketingVersion?
  lastSwiftMigration: MarketingVersion?
  configurationListDebugId: ObjectId?
  buildToolPath: String(!isEmpty)?
  buildToolArguments: String = ""
  buildToolWorkingDirectory: String?
  passBuildSettingsInEnvironment: Boolean = true
}
class Source {
  path: String(!isEmpty)
  kind: "folder" | "file" = "folder"
  excludes: Listing<String>
}
class Dependency {
  target: String(!isEmpty)?
  package: String(!isEmpty)?
  product: String(!isEmpty)?
  productType: PackageProductType = "other"
  platforms: Listing<String>
  link: Boolean = true
  embed: Boolean = false
}
