/// Explicit boundary between JSON values and the fixed internal protocol.
module xcproj.Decode
import "Protocol.pkl" as W
import "Schemes.pkl" as Schemes

function strings(raw: Dynamic): Map<String, String> = raw.toMap().mapValues((k, v) -> v as String)
function settings(raw: Dynamic): W.Settings =
  raw.toMap().mapValues((k, v) -> if (v is String) v else v.toList().map((s) -> s as String))
function optional(raw: Dynamic, key: String): Any? = raw.toMap().getOrNull(key)
function dependency(raw: Dynamic): W.DependencyInput = new {
  target = optional(raw, "target"); package = optional(raw, "package"); product = optional(raw, "product")
  productType = raw.productType; platforms = raw.platforms.toList()
  link = raw.link; embed = raw.embed
}
function package(raw: Dynamic): W.PackageInput = new {
  key = raw.key; identity = raw.identity; pathId = optional(raw, "pathId"); value = raw.value
}
function source(raw: Dynamic): W.SourceInput = new { pathId = raw.pathId; kind = raw.kind; excludes = raw.excludes.toList() }
function target(raw: Dynamic): W.TargetInput = new {
  key = raw.key; name = raw.name; kind = raw.kind; type = optional(raw, "type"); platform = raw.platform
  id = raw.id; productId = raw.productId
  productName = raw.productName; productFileType = raw.productFileType; hasProduct = raw.hasProduct
  details = raw.details
  buildPhases = if (optional(raw, "buildPhases") != null) raw.buildPhases.toList() else null
  preBuildScripts = raw.preBuildScripts.toList(); postBuildScripts = raw.postBuildScripts.toList()
  settings = module.settings(raw.settings)
  configFiles = strings(raw.configFiles)
  configurationDetails = raw.configurationDetails.toMap()
  infoPlistPathId = raw.toMap().getOrNull("infoPlistPathId")
  sources = raw.sources.toList().map((s) -> source(s))
  dependencies = raw.dependencies.toList().map((d) -> dependency(d))
}
function project(raw: Dynamic): W.ProjectInput = new {
  key = raw.key; idNamespace = raw.idNamespace
  sourcePathId = raw.sourcePathId; rootPathId = raw.rootPathId; artifactId = raw.artifactId
  configurations = strings(raw.configurations)
  defaultConfiguration = raw.defaultConfiguration
  settings = module.settings(raw.settings)
  configFiles = strings(raw.configFiles)
  configurationDetails = raw.configurationDetails.toMap()
  details = raw.details; files = raw.files.toList()
  productsGroup = optional(raw, "productsGroup")
  packages = raw.packages.toList().map((entry) -> package(entry))
  targets = raw.targets.toList().map((t) -> target(t))
}
function path(raw: Dynamic): W.PathRequest = new {
  id = raw.id; path = raw.path; expectedKind = raw.expectedKind
  mustExist = raw.mustExist; context = raw.context
  base = new {
    kind = raw.base.kind
    uri = if (raw.base.kind == "uri") raw.base.uri else null
    id = if (raw.base.kind == "request") raw.base.id else null
    location = if (raw.base.kind == "request") raw.base.location else null
  }
}
function artifact(raw: Dynamic): W.ArtifactRequest = new {
  id = raw.id; kind = raw.kind; bundlePathId = raw.bundlePathId; filePathId = raw.filePathId
}
function snapshot(raw: Dynamic): W.Snapshot = new {
  protocolVersion = raw.protocolVersion; schemaVersion = raw.schemaVersion; kind = raw.kind
  rootArtifactId = raw.rootArtifactId
  projects = raw.projects.toList().map((p) -> project(p))
  existingProjects = if (optional(raw, "existingProjects") == null) List()
    else raw.existingProjects.toList().map((p) -> new W.ExistingProjectInput {
      key = p.key; bundlePathId = p.bundlePathId
    })
  paths = raw.paths.toList().map((p) -> path(p))
  artifacts = raw.artifacts.toList().map((a) -> artifact(a))
  schemes = raw.schemes.toList().map((s) -> Schemes.decode(s))
}
function fact(raw: Dynamic): W.PathFact = new {
  absolutePath = raw.absolutePath; canonicalUri = raw.canonicalUri
  components = raw.components.toList()
}
function facts(raw: Dynamic): W.HostFacts = new {
  protocolVersion = raw.protocolVersion
  paths = raw.paths.toMap().mapValues((k, v) -> fact(v))
}
