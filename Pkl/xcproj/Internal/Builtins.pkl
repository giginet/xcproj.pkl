module xcproj.Builtins
import "ProjectModel.pkl" as Model
import "Protocol.pkl" as Wire

function stableId(namespace: String, kind: String, key: String): String =
  "\(namespace)\u{0}\(kind)\u{0}\(key)".sha256.take(24).toUpperCase()

function values(base: Mapping<String, Model.SettingValue>): Wire.Settings =
  base.toMap().mapValues((k, v) -> if (v is String) v else v.toList())

function targetDefaults(p: Model, t: Model.Target): Wire.Settings =
  (new Mapping<String, Wire.SettingValue> {
    ["PRODUCT_NAME"] = "$(TARGET_NAME)"
    ["SWIFT_VERSION"] = "6.0"
    ["SDKROOT"] = if (t.platform == "macOS") "macosx" else "iphoneos"
    ["SUPPORTED_PLATFORMS"] = if (t.platform == "macOS") List("macosx") else List("iphoneos", "iphonesimulator")
    when (t.deploymentTarget != null) {
      [if (t.platform == "macOS") "MACOSX_DEPLOYMENT_TARGET" else "IPHONEOS_DEPLOYMENT_TARGET"] = t.deploymentTarget!!
    }
    when (t.platform == "iOS") { ["TARGETED_DEVICE_FAMILY"] = "1,2" }
    when (t.type != "tool") {
      ["GENERATE_INFOPLIST_FILE"] = if (t.infoPlist == null) "YES" else "NO"
      ["PRODUCT_BUNDLE_IDENTIFIER"] = "\(p.idNamespace).\(t.name.replaceAll(Regex("[^A-Za-z0-9.-]"), "-"))"
    }
    when (t.type == "framework") {
      ["DEFINES_MODULE"] = "YES"
      ["SKIP_INSTALL"] = "YES"
      ["DYLIB_INSTALL_NAME_BASE"] = "@rpath"
    }
    when (t.type == "application") {
      ["LD_RUNPATH_SEARCH_PATHS"] = List("$(inherited)", if (t.platform == "macOS") "@executable_path/../Frameworks" else "@executable_path/Frameworks")
    }
    when (t.type == "app-extension") {
      ["APPLICATION_EXTENSION_API_ONLY"] = "YES"
      ["SKIP_INSTALL"] = "YES"
      ["LD_RUNPATH_SEARCH_PATHS"] = List("$(inherited)", if (t.platform == "macOS") "@executable_path/../Frameworks" else "@executable_path/Frameworks", if (t.platform == "macOS") "@executable_path/../../../../Frameworks" else "@executable_path/../../Frameworks")
    }
  }).toMap()

function configValues(s: Model.Settings, config: String): Wire.Settings =
  if (s.configs.containsKey(config)) values(s.configs[config].base) else Map()

function settings(configs: Mapping<String, String>, s: Model.Settings, defaults: Wire.Settings, target: Boolean): Wire.Settings =
  let (base = defaults + values(s.base))
  base + (new Mapping<String, Wire.SettingValue> {
    for (config in configs.toMap().keys.toList().sort()) {
      for (key, value in defaults + (if (target) Map("SWIFT_OPTIMIZATION_LEVEL", if (configs[config] == "debug") "-Onone" else "-O") else Map()) + values(s.base) + configValues(s, config)) {
        when (!base.containsKey(key) || base[key] != value) {
          ["\(key)[config=\(config)]"] = value
        }
      }
    }
  }).toMap()
