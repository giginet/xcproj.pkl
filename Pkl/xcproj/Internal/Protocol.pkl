module xcproj.Protocol
import "SchemeModel.pkl" as SchemeModel

typealias SettingValue = String | List<String>
typealias Settings = Map<String, SettingValue>
class Snapshot {
  protocolVersion: Int(this == 1) = 1
  schemaVersion: Int(this == 2) = 2
  kind: "project" | "workspace"
  rootArtifactId: String
  projects: List<ProjectInput>
  paths: List<PathRequest>
  artifacts: List<ArtifactRequest>
  schemes: List<SchemeInput>
}
class SchemeInput {
  name: String
  containerArtifactId: String
  ownerProjectKey: String?
  definition: SchemeModel.Scheme
}
class ProjectInput {
  key: String
  idNamespace: String
  sourcePathId: String
  rootPathId: String
  artifactId: String
  configurations: Map<String, String>
  defaultConfiguration: String
  settings: Settings
  configFiles: Map<String, String>
  configurationDetails: Map<String, Dynamic>
  details: Dynamic
  productsGroup: Any?
  files: List<Dynamic>
  packages: List<PackageInput>
  targets: List<TargetInput>
}
class PackageInput {
  key: String
  identity: String
  pathId: String?
  value: Dynamic
}
class TargetInput {
  key: String
  name: String
  kind: String
  type: String?
  platform: String
  id: String
  productId: String
  productName: String
  productFileType: String
  hasProduct: Boolean
  details: Dynamic
  buildPhases: List<Dynamic>?
  preBuildScripts: List<Dynamic>
  postBuildScripts: List<Dynamic>
  settings: Settings
  configFiles: Map<String, String>
  configurationDetails: Map<String, Dynamic>
  infoPlistPathId: String?
  sources: List<SourceInput>
  dependencies: List<DependencyInput>
}
class SourceInput {
  pathId: String
  kind: String
  excludes: List<String>
}
class DependencyInput {
  target: String?
  package: String?
  product: String?
  productType: String
  platforms: List<String>
  link: Boolean
  embed: Boolean
}
class PathBase {
  kind: "uri" | "request"
  uri: String?
  id: String?
  location: ("self" | "parent")?
}
class PathRequest {
  id: String
  base: PathBase
  path: String
  expectedKind: "file" | "directory" | "any"
  mustExist: Boolean
  context: String
}
class ArtifactRequest {
  id: String
  kind: "project" | "workspace" | "scheme"
  bundlePathId: String
  filePathId: String
}
class HostFacts {
  protocolVersion: Int(this == 1) = 1
  paths: Map<String, PathFact>
}
class PathFact {
  absolutePath: String
  canonicalUri: String
  components: List<String>
}
