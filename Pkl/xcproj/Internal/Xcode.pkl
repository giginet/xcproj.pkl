module xcproj.Xcode
import "Protocol.pkl" as W
import "Paths.pkl" as P
import "Builtins.pkl" as B
import "Validation.pkl" as V

class Owner {
  target: W.TargetInput
  source: W.SourceInput
}
function owners(p: W.ProjectInput): List<Owner> =
  p.targets.flatMap((t) -> t.sources.map((s) -> new Owner { target = t; source = s }))
function productName(t: W.TargetInput): String = t.productName
function productType(t: W.TargetInput): String = t.productFileType
function embedPhase(type: String?): String = if (List("app-extension", "watchkit-extension", "watchkit2-extension", "app-extension.messages", "app-extension.messages-sticker-pack").contains(type)) "Embed App Extensions" else "Embed Frameworks"
function dependencyType(p: W.ProjectInput, d: W.DependencyInput): String? =
  if (d.target != null) p.targets.find((t) -> t.key == d.target).type else "framework"
function phase(path: String): String =
  let (ext = path.split(".").last.toLowerCase())
  if (List("swift", "m", "mm", "c", "cc", "cpp", "cxx").contains(ext)) "compile-sources" else if (List("h", "hpp").contains(ext)) "headers" else "resources"
function encoded(facts: W.HostFacts, pathId: String, bundleId: String): String =
  "<PROJECT>/" + P.fromBundle(facts, pathId, bundleId)
function configId(p: W.ProjectInput, facts: W.HostFacts, pathId: String): String =
  B.stableId(p.idNamespace, "xcconfig", P.between(facts, pathId, p.rootPathId))
function configPaths(p: W.ProjectInput): List<String> =
  (p.configFiles.values.toList() + p.targets.flatMap((t) -> t.configFiles.values.toList())).distinct
function configGroups(p: W.ProjectInput, facts: W.HostFacts): Map<String, List<String>> =
  configPaths(p).groupBy((id) -> P.absolute(facts, id))

function excluded(group: List<Owner>, key: String): List<String> =
  group.filter((o) -> o.target.key == key).flatMap((o) -> o.source.excludes).toSet().toList().sort()

function sourceFile(p: W.ProjectInput, facts: W.HostFacts, group: List<Owner>): Dynamic =
  let (first = group.first)
  let (consumers = p.targets.filter((t) -> group.any((o) -> o.target.key == t.key)))
  if (V.check(group.every((o) -> o.source.kind == first.source.kind), "Conflicting source kinds for \(P.absolute(facts, first.source.pathId))"))
  new Dynamic {
    path = encoded(facts, first.source.pathId, "\(p.artifactId):bundle")
    when (first.source.kind == "folder") {
      kind = "folder"
      `target-membership` = consumers.map((t) -> t.name)
      `membership-exceptions` = new Listing {
        for (t in consumers) {
          when (!excluded(group, t.key).isEmpty) {
            new Dynamic { target = t.name; exclusions = excluded(group, t.key) }
          }
        }
      }
    }
    when (first.source.kind == "file") {
      `target-membership` = consumers.map((t) -> "\(t.name)/\(phase(P.absolute(facts, first.source.pathId)))")
    }
  } else throw("Invalid sources")

function configurations(p: W.ProjectInput, facts: W.HostFacts, paths: Map<String, String>, details: Map<String, Dynamic>, specialized: Boolean): List<Any> =
  (new Listing {
    for (config in p.configurations.keys.toList().sort()) {
      when (paths.containsKey(config) || details.containsKey(config)) {
        (details.getOrNull(config) ?? new Dynamic {}) {
          name = config
          when (paths.containsKey(config)) { file = "id:" + configId(p, facts, paths[config]) }
        }
      } else {
        when (!specialized) { config }
      }
    }
  }).toList()

function product(p: W.ProjectInput, t: W.TargetInput): Dynamic = new {
  path = "<PRODUCTS>/" + productName(t)
  id = t.productId
  type = productType(t)
  index = false
  `target-membership` = new Listing {
    for (consumer in p.targets) {
      for (d in consumer.dependencies.distinct) {
        when (d.target == t.key) {
          when (d.link) {
            new Dynamic { `build-phase` = "\(consumer.name)/frameworks"; platforms = d.platforms }
          }
          when (d.embed) {
            new Dynamic {
              `build-phase` = "\(consumer.name)/copy/" + embedPhase(t.type)
              platforms = d.platforms
              `code-sign-on-copy` = true
              when (t.type == "framework") { `header-preservation` = "remove-on-copy" }
            }
          }
        }
      }
    }
  }
}
function packageReference(p: W.ProjectInput, facts: W.HostFacts, d: W.DependencyInput): Dynamic =
  let (entry = p.packages.find((entry) -> entry.key == d.package))
  new {
  package = if (entry.pathId != null) facts.paths[entry.pathId!!].components.last else entry.identity
  `product-name` = d.product
  `product-type` = d.productType
}
function dependency(p: W.ProjectInput, facts: W.HostFacts, d: W.DependencyInput): Dynamic =
  if (d.target != null) new {
    kind = "localTarget"; target = p.targets.find((t) -> t.key == d.target).name; platforms = d.platforms
  } else (packageReference(p, facts, d)) { kind = "package"; platforms = d.platforms }

function defaultPhases(p: W.ProjectInput, t: W.TargetInput): List<Any> =
  (new Listing {
    when (t.kind == "native") { "headers"; "compile-sources"; "frameworks"; "resources" }
    for (phase in List("Embed Frameworks", "Embed App Extensions")) {
      when (t.dependencies.any((d) -> d.embed && embedPhase(dependencyType(p, d)) == phase)) {
        new Dynamic { kind = "copy"; name = phase; `bundle-base-path` = if (phase == "Embed Frameworks") "frameworks-directory" else "plugins-directory" }
      }
    }
  }).toList()

function target(p: W.ProjectInput, facts: W.HostFacts, t: W.TargetInput): Dynamic = (t.details) {
  name = t.name
  id = t.id
  when (t.hasProduct) { product = "Products/" + productName(t) }
  when (t.type != null) { `product-type` = t.type }
  `build-phases` = t.preBuildScripts + (t.buildPhases ?? defaultPhases(p, t)) + t.postBuildScripts
  `package-product-members` = t.details.`package-product-members`.toList() + (new Listing {
    for (d in t.dependencies) {
      when (d.package != null && d.link && d.productType != "build-tool-plugin") {
        (packageReference(p, facts, d)) {
          `build-phase` = new Dynamic { `build-phase` = "frameworks"; platforms = d.platforms }
        }
      }
      when (d.package != null && d.embed) {
        (packageReference(p, facts, d)) {
          `build-phase` = new Dynamic { `build-phase` = "copy/Embed Frameworks"; platforms = d.platforms; `code-sign-on-copy` = true; `header-preservation` = "remove-on-copy" }
        }
      }
    }
  }).toList()
  `build-settings` = t.settings + (if (t.infoPlistPathId != null)
    Map("INFOPLIST_FILE", P.fromBundle(facts, t.infoPlistPathId!!, "\(p.artifactId):bundle")) else Map())
  dependencies = t.details.dependencies.toList() + t.dependencies.distinct.map((d) -> dependency(p, facts, d))
  `specialized-configurations` = configurations(p, facts, t.configFiles, t.configurationDetails, true)
}
function document(p: W.ProjectInput, facts: W.HostFacts): Dynamic =
  let (groups = owners(p).groupBy((o) -> P.absolute(facts, o.source.pathId)))
  let (configs = configGroups(p, facts))
  (p.details) {
    ["products-group"] = p.productsGroup
    `default-configuration` = p.defaultConfiguration
    configurations = module.configurations(p, facts, p.configFiles, p.configurationDetails, false)
    packages = p.packages.map((entry) -> if (entry.pathId != null)
      (entry.value) { path = P.fromBundle(facts, entry.pathId!!, "\(p.artifactId):bundle") } else entry.value)
    files = new Listing {
      for (file in p.files) { file }
      for (path in groups.keys.toList().sort()) { sourceFile(p, facts, groups[path]) }
      when (!configs.isEmpty) {
        new Dynamic {
          kind = "group"; name = "Configurations"
          children = new Listing {
            for (canonical in configs.keys.toList().sort()) {
              new Dynamic {
                path = encoded(facts, configs[canonical].first, "\(p.artifactId):bundle")
                id = configId(p, facts, configs[canonical].first)
              }
            }
          }
        }
      }
      when (p.targets.any((t) -> t.hasProduct)) {
        new Dynamic { kind = "group"; name = "Products"; children = p.targets.filter((t) -> t.hasProduct).map((t) -> product(p, t)) }
      }
    }
    targets = p.targets.map((t) -> target(p, facts, t))
    `build-settings` = p.settings
  }
