module xcproj.Snapshot
import "pkl:reflect"
import "../Project.pkl" as Model
import "Protocol.pkl" as W
import "Builtins.pkl" as B
import "Projection.pkl" as Projection
import "SchemaRender.pkl" as R
import "Schemes.pkl" as Schemes
import "../Workspace.pkl" as Workspace

function ref(identifier: String, relation: String): W.PathBase = new { kind = "request"; id = identifier; location = relation }
function uri(value: String): W.PathBase = new { kind = "uri"; uri = value }
function path(identifier: String, anchor: W.PathBase, value: String, expected: String, required: Boolean, label: String): W.PathRequest =
  new { id = identifier; base = anchor; path = value; expectedKind = expected; mustExist = required; context = label }
function artifact(identifier: String, type: String): W.ArtifactRequest =
  new { id = identifier; kind = type; bundlePathId = "\(identifier):bundle"; filePathId = "\(identifier):file" }
function projectId(key: String): String = "project:\(key.sha256.take(16))"
function targetId(prefix: String, key: String): String = "\(prefix):target:\(key.sha256.take(16))"
function configId(prefix: String, key: String): String = "\(prefix):config:\(key.sha256.take(16))"

function configFiles(prefix: String, entries: Mapping<String, String>): Map<String, String> =
  entries.toMap().mapValues((k, v) -> configId(prefix, k))

function target(p: Model, prefix: String, k: String, t: Model.Target): W.TargetInput = new {
  key = k
  name = t.name
  kind = t.kind
  type = t.type
  platform = t.platform
  id = t.id ?? B.stableId(p.bundleIdPrefix, "target", k)
  productId = t.productId ?? B.stableId(p.bundleIdPrefix, "product", k)
  productName = B.productName(t)
  productFileType = B.productFileType(t)
  hasProduct = t.kind == "native" && t.product == null
  details = Projection.target(p, t)
  buildPhases = t.buildPhases?.toList()?.map((v) -> R.buildPhase(v))
  preBuildScripts = t.preBuildScripts.toList().map((v) -> R.buildPhase(v))
  postBuildScripts = t.postBuildScripts.toList().map((v) -> R.buildPhase(v))
  settings = B.settings(p.configs, t.settings, B.targetDefaults(p, t), true)
  configFiles = module.configFiles(targetId(prefix, k), t.configFiles)
  configurationDetails = Projection.configurations(t.configurationDetails)
  infoPlistPathId = if (t.infoPlist != null) "\(targetId(prefix, k)):infoPlist" else null
  sources = t.sources.toList().mapIndexed((i, s) -> new W.SourceInput {
    pathId = "\(targetId(prefix, k)):source:\(i)"
    kind = s.kind
    excludes = s.excludes.toList()
  })
  dependencies = t.dependencies.toList().map((d) -> new W.DependencyInput {
    target = d.target; package = d.package; product = d.product; productType = d.productType
    platforms = d.platforms.toList(); link = d.link; embed = d.embed
  }).distinct
}

function project(p: Model, k: String): W.ProjectInput = new {
  key = k
  idNamespace = p.bundleIdPrefix
  sourcePathId = "\(projectId(k)):module"
  rootPathId = "\(projectId(k)):root"
  artifactId = projectId(k)
  configurations = p.configs.toMap()
  defaultConfiguration = p.defaultConfiguration
  settings = B.settings(p.configs, p.settings, Map("ALWAYS_SEARCH_USER_PATHS", "NO"), false)
  configFiles = module.configFiles(projectId(k), p.configFiles)
  configurationDetails = Projection.configurations(p.configurationDetails)
  details = Projection.project(p)
  productsGroup = if (p.productsGroup != null) R.namePath(p.productsGroup!!) else null
  files = p.files.toList().map((v) -> R.reference(v))
  packages = p.packages.toMap().keys.toList().sort().map((packageKey) -> new W.PackageInput {
    key = packageKey
    identity = Projection.packageIdentity(p.packages[packageKey])
    pathId = if (p.packages[packageKey] is Model.LocalSwiftPackage) "\(projectId(k)):package:\(packageKey.sha256.take(16))" else null
    value = R.swiftPackage(p.packages[packageKey])
  })
  targets = p.targets.toMap().keys.toList().sort().map((key) -> target(p, projectId(k), key, p.targets[key]))
}

function projectPaths(p: Model, k: String): List<W.PathRequest> =
  let (prefix = projectId(k))
  (new Listing<W.PathRequest> {
    path("\(prefix):module", uri(reflect.moduleOf(p).uri), "", "file", true, "Project module \(k)")
    path("\(prefix):root", ref("\(prefix):module", "parent"), p.projectDir, "directory", true, "\(k).projectDir")
    path("\(prefix):bundle", ref("\(prefix):root", "self"), "\(p.name).xcodeproj", "any", false, "\(k) output")
    path("\(prefix):file", ref("\(prefix):bundle", "self"), "project.xcproj", "any", false, "\(k) output file")
    for (config, value in p.configFiles) {
      path(configId(prefix, config), ref("\(prefix):root", "self"), value, "file", true, "\(k).configFiles.\(config)")
    }
    for (key, package in p.packages) {
      when (package is Model.LocalSwiftPackage) {
        path("\(prefix):package:\(key.sha256.take(16))", ref("\(prefix):root", "self"), package.path, "directory", true, "\(k).packages.\(key)")
      }
    }
    for (key in p.targets.toMap().keys.toList().sort()) {
      when (p.targets[key].infoPlist != null) {
        path("\(targetId(prefix, key)):infoPlist", ref("\(prefix):root", "self"), p.targets[key].infoPlist!!, "file", true, "\(k).targets.\(key).infoPlist")
      }
      for (config, value in p.targets[key].configFiles) {
        path(configId(targetId(prefix, key), config), ref("\(prefix):root", "self"), value, "file", true, "\(k).targets.\(key).configFiles.\(config)")
      }
      for (i, source in p.targets[key].sources) {
        path("\(targetId(prefix, key)):source:\(i)", ref("\(prefix):root", "self"), source.path, if (source.kind == "folder") "directory" else "file", true, "\(k).targets.\(key).sources")
        for (j, exclude in source.excludes) {
          path("\(targetId(prefix, key)):source:\(i):exclude:\(j)", ref("\(targetId(prefix, key)):source:\(i)", "self"), exclude, "any", true, "\(k).targets.\(key).excludes")
        }
      }
    }
  }).toList()

function single(p: Model): W.Snapshot = new {
  kind = "project"
  rootArtifactId = projectId("project")
  projects = List(project(p, "project"))
  schemes = Schemes.projectEntries(p.schemes, "project", projectId("project"))
  paths = projectPaths(p, "project") + Schemes.paths(schemes)
  artifacts = List(artifact(projectId("project"), "project")) + Schemes.artifacts(schemes)
}

function workspace(label: String, directory: String, source: String, entries: Mapping<String, Workspace.WorkspaceProject>, schemeEntries: Mapping<String, Model.Scheme>): W.Snapshot =
  let (keys = entries.toMap().keys.toList().sort())
  let (generatedKeys = keys.filter((k) -> entries[k] is Model))
  let (existingKeys = keys.filter((k) -> entries[k] is Workspace.ExistingProject))
  new {
    kind = "workspace"
    rootArtifactId = "workspace"
    projects = generatedKeys.map((k) -> project(entries[k] as Model, k))
    existingProjects = existingKeys.map((k) -> new W.ExistingProjectInput {
      key = k; bundlePathId = "\(projectId(k)):bundle"
    })
    schemes = generatedKeys.flatMap((k) -> Schemes.projectEntries((entries[k] as Model).schemes, k, projectId(k))) + Schemes.workspaceEntries(schemeEntries)
    paths = generatedKeys.flatMap((k) -> projectPaths(entries[k] as Model, k)) + existingKeys.map((k) ->
      path("\(projectId(k)):bundle", ref("workspace:root", "self"), (entries[k] as Workspace.ExistingProject).path, "directory", true, "\(k) existing project")
    ) + List(
      path("workspace:module", uri(source), "", "file", true, "Workspace module"),
      path("workspace:root", ref("workspace:module", "parent"), directory, "directory", true, "workspaceDir"),
      path("workspace:bundle", ref("workspace:root", "self"), "\(label).xcworkspace", "any", false, "Workspace output"),
      path("workspace:file", ref("workspace:bundle", "self"), "contents.xcworkspacedata", "any", false, "Workspace output file")
    ) + Schemes.paths(schemes)
    artifacts = generatedKeys.map((k) -> artifact(projectId(k), "project")) + List(artifact("workspace", "workspace")) + Schemes.artifacts(schemes)
  }
