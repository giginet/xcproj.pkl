# Generated by Scripts/update-homebrew-formula.py. Edit this template, not xcprojgen.rb.
class Xcprojgen < Formula
  desc "Generate Xcode projects and workspaces from Pkl"
  homepage "https://github.com/giginet/xcproj.pkl"
  url "https://github.com/giginet/xcproj.pkl/releases/download/@VERSION@/xcprojgen-@VERSION@-macos-universal.tar.gz"
  version "@VERSION@"
  sha256 "@SHA256@"
  license "Apache-2.0"

  depends_on :macos
  depends_on "pkl"

  on_macos do
    depends_on macos: :sonoma
  end

  def install
    prefix.install "LICENSE", "Licenses"
    libexec.install "xcprojgen", "xcprojgen_PklRuntimeResources.bundle"
    bin.write_exec_script libexec/"xcprojgen"
  end

  def caveats
    <<~EOS
      Generating Xcode projects requires Xcode 27.2 or later.
      Run `xcprojgen doctor` to check Pkl and the selected Xcode installation.
    EOS
  end

  test do
    assert_equal version.to_s, shell_output("#{bin}/xcprojgen --version").strip
    system bin/"xcprojgen", "init", testpath/"Example", "--type", "project"
    assert_match "/#{version}/xcproj@#{version}", (testpath/"Example/PklProject").read
  end
end
