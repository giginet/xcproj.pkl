amends "../../Pkl/xcproj/Project.pkl"
import "../Shared/Templates.pkl" as Shared
name = "Demo"
idNamespace = "com.example.demo"
configFiles { ["Debug"] = "Config/Debug.xcconfig" }
targets {
  ["core"] = new Shared.Framework { name = "DemoCore"; bundleSuffix = "core" }
  ["app"] = new Shared.App {
    name = "DemoApp"
    bundleSuffix = "app"
    dependencies { new { target = "core"; embed = true } }
  }
  ["tests"] = new Shared.UnitTests {
    name = "DemoCoreTests"
    bundleSuffix = "tests"
    dependencies { new { target = "core" } }
  }
}
