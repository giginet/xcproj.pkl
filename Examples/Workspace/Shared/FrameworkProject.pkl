open module examples.FrameworkProject
extends "@xcproj/Project.pkl"
import "../../Shared/Settings.pkl" as Common

open class SwiftTarget extends Target {
  platform = "macOS"
  deploymentTarget = "14.0"
  settings = (Common.compiler) { base { ["CODE_SIGNING_ALLOWED"] = "NO" } }
}
open class Framework extends SwiftTarget { type = "framework"; sources { new { path = "Sources" } } }
open class UnitTests extends SwiftTarget {
  type = "bundle.unit-test"
  sources { new { path = "Tests" } }
  dependencies { new { target = "framework" } }
}
idNamespace = "com.example.\(name)"
targets {
  ["framework"] = new Framework { name = module.name }
  ["tests"] = new UnitTests { name = "\(module.name)Tests" }
}
