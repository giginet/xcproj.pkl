amends "../../Pkl/xcproj/Project.pkl"
import "../Shared/Templates.pkl" as Shared
name = "Tool"
idNamespace = "com.example.tool"
settings { base { ["OTHER_SWIFT_FLAGS"] = new Listing { "-DPROJECT" } } }
targets {
  ["hello"] = new Shared.MacTool {
    name = "Hello"
    settings { base { ["CODE_SIGNING_ALLOWED"] = "NO" } }
  }
}
