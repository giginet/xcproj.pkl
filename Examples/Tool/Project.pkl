amends "../../Pkl/Project.pkl"
import "../Shared/Settings.pkl" as SharedSettings
import "../Shared/Templates.pkl" as SharedTemplates

name = "Tool"
idNamespace = "com.example.tool"

settingGroups {
  ["warnings"] = SharedSettings.warnings
  ["compiler"] = SharedSettings.compiler
}
targetTemplates {
  ["Swift"] = SharedTemplates.swiftTarget
  ["MacTool"] = SharedTemplates.macOSTool
}
settings {
  base {
    ["OTHER_SWIFT_FLAGS"] = new Listing { "-DPROJECT" }
  }
}
targets {
  ["hello"] {
    name = "Hello"
    templates { "MacTool" }
    settings { base { ["CODE_SIGNING_ALLOWED"] = "NO" } }
  }
}
